{
  "name": "@arkivist/claude",
  "version": "0.2.1",
  "description": "Connect your Claude Code to your Arkivist account",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:bundle": "node scripts/build.mjs --check",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "esbuild": "0.28.2"
  },
  "main": "dist/cli.js",
  "bin": {
    "arkivist-claude": "dist/cli.js"
  },
  "files": [
    "dist",
    "plugin",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "private": false
}
